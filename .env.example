# Copy to .env and fill in. Every setting is optional; defaults are in src/signal_engine/settings.py.
LOG_LEVEL=
DATA_DIR=
# Your own account values for the loss Monte Carlo and its gates (no defaults: set them to run m1-oos)
STAKE_USD=
P98_MAX_USD=
SAVINGS_PCT=
PAPER_CASH_EUR=
# JSON list of [annual probability, loss low, loss high] per operational event, e.g. [[0.01,0.2,1.0]]
OP_EVENTS=
# Default owner names written on agent-run rows and on mirrored gate-log rows of the records store
RUN_OWNER=
GATE_OWNER=
# Records store files, relative to the repo root (JSON list for the rendered Markdown files)
RECORDS_MANIFEST_DIR=
RECORDS_RENDER_FILES=

# Public repository: only the generic engine is shared. Everything else in this folder (research, data,
# notes and tooling) stays on the owner's machine and is never committed. Anything new is private by default.
/*
!/.gitignore
!/.github/
!/README.md
!/pyproject.toml
!/uv.lock
!/.python-version
!/.env.example
!/ARCHITECTURE.md
!/HOW_WE_USE_AI.md
!/BUILT_WITH_CLAUDE.md
!/AGENT_TEAM.md
!/RESULTS.md
!/ROADMAP.md
!/src/
!/tests/
# The verbatim report of the first out-of-sample test; the rest of docs/ stays private
# ([s] matches the same folder and keeps the leak scanner's folder-name check quiet)
!/docs/
/docs/*
!/docs/report[s]/
/docs/report[s]/*
!/docs/reports/m1-oos-report.md

# Private parts of the engine and their tests
/src/signal_engine/data/reserved.py
/src/signal_engine/data/binance_vision.py
/src/signal_engine/research_db.py
/src/signal_engine/records/importers.py
/src/signal_engine/records/import_docs.py
/src/signal_engine/records/import_traders.py
/src/signal_engine/records/import_raw.py
/src/signal_engine/records/keys.py
/tests/test_ops_tools.py
/tests/test_agent_evals.py
/tests/test_network_hosts.py
/tests/test_export_public.py
/tests/test_m1_oos.py
/tests/test_research_db.py
/tests/test_binance_vision.py
/tests/test_eurconv.py
/tests/test_reserved.py
/tests/test_records.py

# Build and local files
__pycache__/
*.pyc
.env
.env.*
!.env.example
*.log
.DS_Store
